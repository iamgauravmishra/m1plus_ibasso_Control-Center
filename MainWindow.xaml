<Window x:Class="DC07Pro.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAC Control Center" Height="790" Width="1040" MinHeight="680" MinWidth="850"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" Background="#0A0D14" Foreground="#F4F7FF"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <LinearGradientBrush x:Key="WindowGlass" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#182334" Offset="0"/><GradientStop Color="#101725" Offset="0.55"/><GradientStop Color="#171B2A" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGlass" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#CC26364D" Offset="0"/><GradientStop Color="#B31A2639" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#7CE7FF" Offset="0"/><GradientStop Color="#8D9BFF" Offset="1"/></LinearGradientBrush>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF4FF"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="#9AAAC1"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardGlass}"/><Setter Property="BorderBrush" Value="#53647B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#07111F"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="WindowControlButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D8E5F5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="Transparent" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#263B5068"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#40516B85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CloseWindowControlButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D83B45"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#172337"/><Setter Property="Foreground" Value="#F4F7FF"/><Setter Property="BorderBrush" Value="#53647B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE7F7"/><Setter Property="Margin" Value="0,4,18,4"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="#83DFFF"/><Setter Property="Margin" Value="0,10,0,7"/></Style>
    <Style TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="#496783" BorderBrush="#6D8BA8" BorderThickness="1" CornerRadius="5" Margin="1" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#506985"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" SnapsToDevicePixels="True"><Border Background="#172337" CornerRadius="5"/><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.Thumb><Thumb/></Track.Thumb></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#C9D8EB"/><Setter Property="Background" Value="#192A40"/><Setter Property="BorderBrush" Value="#465B75"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chip" Property="Background" Value="#31516C"/><Setter TargetName="Chip" Property="BorderBrush" Value="#7CE7FF"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#7CE7FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#AAB9D0"/><Setter Property="Background" Value="#19263A"/><Setter Property="Padding" Value="22,13"/><Setter Property="MinWidth" Value="210"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="#43536B" BorderThickness="1" CornerRadius="12,12,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tabBorder" Property="Background" Value="#314761"/><Setter TargetName="tabBorder" Property="BorderBrush" Value="#80DFFF"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Background="{StaticResource WindowGlass}">
    <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-170,0" Opacity="0.12" Fill="#58BCEB" IsHitTestVisible="False"/>
    <Ellipse Width="440" Height="440" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-220,0,0,-250" Opacity="0.10" Fill="#9A8BFF" IsHitTestVisible="False"/>
    <Grid Height="42" VerticalAlignment="Top" Margin="14,4,10,0" Background="#182334" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
        <Ellipse Width="8" Height="8" Fill="#7CE7FF" Margin="0,0,10,0"/>
        <TextBlock Text="DAC CONTROL CENTER" Foreground="#C9D8EB" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <Button Grid.Column="1" Content="&#xE921;" Style="{StaticResource WindowControlButton}" Click="MinimizeWindow_Click"/>
      <Button x:Name="MaximizeWindowButton" Grid.Column="2" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="MaximizeWindow_Click"/>
      <Button Grid.Column="3" Content="&#xE8BB;" Style="{StaticResource CloseWindowControlButton}" Click="CloseWindow_Click"/>
    </Grid>
    <Grid Margin="30,52,30,30">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="DAC CONTROL CENTER" FontSize="12" FontWeight="Bold" Foreground="#82DFFF"/><TextBlock Text="Your audio. Precisely controlled." FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock Text="iBasso DC07 Pro  ·  Shanling M1 Plus" Style="{StaticResource MutedText}" FontSize="13"/></StackPanel>
        <Border Grid.Column="1" Background="#8C1C2A3D" BorderBrush="#53647B" BorderThickness="1" CornerRadius="16" Padding="16,11" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#8C9AAF" Margin="0,0,10,0"/><StackPanel><TextBlock x:Name="ConnectionText" Text="Detecting device…" FontWeight="SemiBold"/><TextBlock x:Name="FirmwareText" Text="FPGA —" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></StackPanel></Border>
      </Grid>
      <TabControl Grid.Row="1">
        <TabItem Header="  iBASSO  ·  DC07 PRO  "><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,16,4,0">
          <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.RowSpan="3" VerticalAlignment="Center"><TextBlock Text="Master volume" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Hardware volume · 0–100" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="VolumeValue" Grid.Column="1" Text="— / 100" FontSize="22" FontWeight="Bold" Foreground="#8DE8FF" HorizontalAlignment="Right"/><Slider x:Name="VolumeSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="40" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Changes apply live from the slider or keyboard knob." Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Digital filter" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="DAC reconstruction" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><CheckBox x:Name="HpFilterCheck" Content="HP Filter" Margin="0,14,0,0"/></StackPanel><ListBox x:Name="FilterCombo" Grid.Column="1" SelectedIndex="4"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem Content="Phase-comp Fast"/><ListBoxItem Content="Phase-comp Slow"/><ListBoxItem Content="Low-lat Fast"/><ListBoxItem Content="Low-lat Slow"/><ListBoxItem Content="NOS"/></ListBox></Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Output configuration" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Gain, balance and digital output" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><CheckBox x:Name="SpdifCheck" Content="S/PDIF output" Margin="0,16,0,0"/></StackPanel><StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Gain" FontWeight="SemiBold" VerticalAlignment="Center"/><ListBox x:Name="GainCombo" Grid.Column="1" SelectedIndex="1"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem Content="Low"/><ListBoxItem Content="Mid"/><ListBoxItem Content="High"/></ListBox></Grid><Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Channel balance" FontWeight="SemiBold" VerticalAlignment="Center"/><Slider x:Name="BalanceSlider" Grid.Column="1" Minimum="0" Maximum="20" Value="10" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock x:Name="BalanceValue" Grid.Column="2" Text="10 / 20" Foreground="#8DE8FF" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></StackPanel></Grid></Border>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Display &amp; controls" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Screen behaviour" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Timeout" FontWeight="SemiBold" VerticalAlignment="Center"/><ListBox x:Name="TimeoutCombo" Grid.Column="1" SelectedIndex="0"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem Content="10s"/><ListBoxItem Content="20s"/><ListBoxItem Content="30s"/><ListBoxItem Content="Always On"/></ListBox></Grid><WrapPanel Margin="100,14,0,0"><CheckBox x:Name="RotationCheck" Content="Rotate display"/><CheckBox x:Name="HardwareKeysCheck" Content="Hardware key control"/></WrapPanel></StackPanel></Grid></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="  SHANLING  ·  M1 PLUS  "><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,16,4,0">
          <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Row="0"><TextBlock Text="Shanling M1 Plus" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ShanlingStatusText" Text="Waiting for USB DAC + SyncLink" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="0" Grid.Column="1" Background="#263B52" CornerRadius="10" Padding="12,8" HorizontalAlignment="Right"><TextBlock Text="DAC MODE" Foreground="#8DE8FF" FontWeight="Bold" FontSize="11"/></Border><TextBlock Grid.Row="1" Text="Player IP address" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,22,0,10"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="ShanlingIpText" Text="192.168.1.16" Height="38" Width="260" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,18,0,8"/><Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Volume" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Player output level" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="ShanlingVolumeValue" Text="— / 90" FontSize="25" FontWeight="Bold" Foreground="#8DE8FF" HorizontalAlignment="Right"/><Slider x:Name="ShanlingVolumeSlider" Minimum="0" Maximum="90" Value="61" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,2"/></StackPanel></Grid></Grid></Border>
          <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Connection requirements" FontWeight="SemiBold"/><TextBlock Text="M1 Plus is connected only while USB audio and SyncLink authentication are both present. Volume writes are sent asynchronously over the persistent session." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="  APP SETTINGS  "><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,16,4,0">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Startup &amp; background" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Control how DAC Control Center starts and stays available." Style="{StaticResource MutedText}" Margin="0,5,0,16"/>
            <CheckBox x:Name="RunAtStartupCheck" Content="Run DAC Control Center when I sign in to Windows" Margin="0,5,0,12"/>
            <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to the notification area (system tray)" Margin="0,5,0,12"/>
            <CheckBox x:Name="ShowOnDeviceCheck" Content="Show the app window automatically when an iBasso or Shanling DAC is detected" Margin="0,5,0,12"/>
            <TextBlock Text="When started in the background, the app monitors USB and SyncLink quietly. If device detection is enabled, its window opens when either supported DAC becomes available. Use the tray icon to open the app or exit." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Notification area" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Right-click the DAC Control Center tray icon for Open and Exit. Double-click the icon to restore the window." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
      <Border Grid.Row="2" Background="#A51B2A40" BorderBrush="#455A75" BorderThickness="1" CornerRadius="13" Padding="14,11" Margin="0,14,0,0"><DockPanel><Ellipse Width="7" Height="7" Fill="#7DE3FF" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Detecting devices automatically…" Foreground="#C9D8EB" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
    </Grid>
  </Grid>
</Window>